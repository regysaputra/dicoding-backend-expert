{
  "name": "forum-api",
  "version": "1.0.0",
  "description": "Dicoding submission for \"Menjadi Backend Developer Expert dengan javascript\" class",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node src/app.js",
    "start:dev": "cross-env NODE_ENV=development nodemon src/app.js",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js -i",
    "test:watch": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --watch -i",
    "test:use_case": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js src/Applications/use_case --runInBand",
    "test:coverage": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage -i",
    "migrate": "node-pg-migrate",
    "migrate:test": "dotenv -e .test.env -- sh -c 'DATABASE_URL=\"postgresql://${PGUSER}:${PGPASSWORD}@${PGHOST}:${PGPORT}/${PGDATABASE}?sslmode=no-verify\" NODE_OPTIONS=--dns-result-order=ipv4first node-pg-migrate --database-url \"$DATABASE_URL\" \"$@\"' --",
    "lint": "eslint ./",
    "format": "prettier --write"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^11.0.0",
    "express": "^5.0.1",
    "globals": "^17.5.0",
    "instances-container": "^2.0.6",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.9",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.16.3",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@jest/globals": "^30.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.38.0",
    "eslint-config-dicodingacademy": "^0.9.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "jest": "^30.3.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.8.3",
    "supertest": "^7.1.4"
  }
}
